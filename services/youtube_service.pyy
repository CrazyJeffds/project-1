import os
import uuid
from pathlib import Path

import yt_dlp

from database.db import get_settings


DOWNLOAD_ROOT = Path("storage/downloads")


def download_youtube(
    url,
    progress_callback=None,
    user_id=None
):

    DOWNLOAD_ROOT.mkdir(
        parents=True,
        exist_ok=True
    )

    # ==========================================
    # УНИКАЛЬНАЯ ПАПКА ДЛЯ КАЖДОГО СКАЧИВАНИЯ
    # ==========================================

    download_id = uuid.uuid4().hex

    download_dir = (
        DOWNLOAD_ROOT
        / download_id
    )

    download_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    # ==========================================
    # КАЧЕСТВО
    # ==========================================

    quality = "480"

    if user_id is not None:

        try:

            settings = get_settings(
                user_id
            )

            quality = settings.get(
                "video_quality",
                "480"
            )

        except Exception:

            quality = "480"

    # ==========================================
    # ПРОГРЕСС
    # ==========================================

    def progress_hook(data):

        if progress_callback is None:
            return

        if data["status"] == "downloading":

            downloaded = data.get(
                "downloaded_bytes",
                0
            )

            total = (
                data.get("total_bytes")
                or
                data.get(
                    "total_bytes_estimate"
                )
            )

            if total:

                percent = int(
                    downloaded
                    / total
                    * 100
                )

                try:

                    progress_callback(
                        percent
                    )

                except Exception:
                    pass

        elif data["status"] == "finished":

            try:

                progress_callback(
                    100
                )

            except Exception:
                pass

    # ==========================================
    # YT-DLP
    # ==========================================

    ydl_opts = {

        # Например:
        # 720p -> максимум 720
        "format": (
            f"bv*[height<={quality}]"
            f"+ba/"
            f"b[height<={quality}]/"
            f"b"
        ),

        "merge_output_format": "mp4",

        # Используем ID, а не название видео.
        # Так меньше проблем со спецсимволами.
        "outtmpl": str(
            download_dir
            / "%(id)s.%(ext)s"
        ),

        "noplaylist": True,

        "restrictfilenames": True,

        "progress_hooks": [
            progress_hook
        ],

        # Не использовать уже существующие
        # повреждённые временные файлы
        "continuedl": False,

        # Если старый .part вдруг остался,
        # yt-dlp не будет пытаться продолжить его
        "overwrites": True,

        "quiet": False,

        "no_warnings": False,
    }

    try:

        with yt_dlp.YoutubeDL(
            ydl_opts
        ) as ydl:

            info = ydl.extract_info(
                url,
                download=True
            )

            # ==================================
            # ПЫТАЕМСЯ ПОЛУЧИТЬ ГОТОВЫЙ ПУТЬ
            # ==================================

            requested_downloads = (
                info.get(
                    "requested_downloads"
                )
                or []
            )

            for item in requested_downloads:

                filepath = item.get(
                    "filepath"
                )

                if (
                    filepath
                    and
                    os.path.exists(filepath)
                ):

                    return filepath

            # ==================================
            # ПОСЛЕ MERGE ЧАЩЕ ВСЕГО MP4
            # ==================================

            prepared = ydl.prepare_filename(
                info
            )

            base_path = os.path.splitext(
                prepared
            )[0]

            possible_files = [
                base_path + ".mp4",
                base_path + ".webm",
                base_path + ".mkv",
                prepared
            ]

            for path in possible_files:

                if os.path.exists(
                    path
                ):

                    return path

            # ==================================
            # ПОСЛЕДНИЙ ВАРИАНТ:
            # ИЩЕМ ЛЮБОЙ ГОТОВЫЙ ФАЙЛ
            # ==================================

            files = []

            for file in download_dir.iterdir():

                if not file.is_file():
                    continue

                if file.name.endswith(
                    ".part"
                ):
                    continue

                if file.name.endswith(
                    ".ytdl"
                ):
                    continue

                files.append(
                    file
                )

            if files:

                # Берём самый большой файл.
                # Обычно это итоговое видео.
                files.sort(
                    key=lambda x: x.stat().st_size,
                    reverse=True
                )

                return str(
                    files[0]
                )

            raise FileNotFoundError(
                "yt-dlp завершил работу, "
                "но итоговый файл не найден"
            )

    except Exception:

        # Не удаляем папку здесь специально,
        # чтобы лог yt-dlp было легче проверить.
        raise
